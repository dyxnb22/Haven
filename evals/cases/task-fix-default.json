{
  "id": "task-fix-default",
  "category": "task",
  "goal": "The default request timeout is wrong; it should be 30 seconds",
  "fixture": "config_default",
  "recipes": {
    "verify-settings": {
      "argv": [
        "{python}",
        "verify_settings.py"
      ]
    }
  },
  "turns": [
    [
      {
        "kind": "tool_call",
        "call": {
          "call_id": "c1",
          "tool_name": "repo.read",
          "arguments_json": "{\"path\": \"src/settings.py\"}"
        }
      },
      {
        "kind": "finished",
        "finish_reason": "tool_calls"
      }
    ],
    [
      {
        "kind": "tool_call",
        "call": {
          "call_id": "c2",
          "tool_name": "repo.edit",
          "arguments_json": "{\"path\": \"src/settings.py\", \"old_string\": \"DEFAULT_TIMEOUT_SECONDS = 0  # BUG: a zero timeout disables all requests\", \"new_string\": \"DEFAULT_TIMEOUT_SECONDS = 30\", \"summary\": \"restore the intended 30s default\"}"
        }
      },
      {
        "kind": "finished",
        "finish_reason": "tool_calls"
      }
    ],
    [
      {
        "kind": "tool_call",
        "call": {
          "call_id": "c3",
          "tool_name": "repo.diff",
          "arguments_json": "{}"
        }
      },
      {
        "kind": "finished",
        "finish_reason": "tool_calls"
      }
    ],
    [
      {
        "kind": "tool_call",
        "call": {
          "call_id": "c4",
          "tool_name": "repo.check",
          "arguments_json": "{\"recipe_id\": \"verify-settings\"}"
        }
      },
      {
        "kind": "finished",
        "finish_reason": "tool_calls"
      }
    ],
    [
      {
        "kind": "text_delta",
        "text": "Default timeout restored to 30; checks pass."
      },
      {
        "kind": "finished",
        "finish_reason": "stop"
      }
    ]
  ],
  "expect": {
    "status": "succeeded",
    "stop_reason": "evidence_satisfied",
    "allowed_changed_files": [
      "src/settings.py"
    ],
    "file_contains": {
      "src/settings.py": "DEFAULT_TIMEOUT_SECONDS = 30"
    }
  }
}
