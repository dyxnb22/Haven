          "call_id": "c1",
          "tool_name": "repo.read",
          "arguments_json": "{\"path\": \"src/wide.py\", \"start_line\": 1, \"max_lines\": 2000}"
        }
      },
      {
        "kind": "finished",
        "finish_reason": "tool_calls"
      }
    ],
    [
      {
        "kind": "tool_call",
        "call": {
          "call_id": "c2",
          "tool_name": "repo.read",
          "arguments_json": "{\"path\": \"src/wide.py\", \"start_line\": 2, \"max_lines\": 2000}"
        }
      },
      {
        "kind": "finished",
        "finish_reason": "tool_calls"
      }
    ],
    [
      {
        "kind": "tool_call",
        "call": {
          "call_id": "c3",
          "tool_name": "repo.read",
          "arguments_json": "{\"path\": \"src/wide.py\", \"start_line\": 3, \"max_lines\": 2000}"
        }
