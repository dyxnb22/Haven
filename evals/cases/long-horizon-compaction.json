{
  "id": "long-horizon-compaction",
  "category": "robustness",
  "goal": "Fix add() in a large module that does not fit in one context",
  "fixture": "long_horizon",
  "recipes": {
    "verify-wide": {
      "argv": [
        "{python}",
        "verify_wide.py"
      ]
    }
  },
  "turns": [
